# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.nx/cache
.nx/workspace-data
.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

.claude/worktrees
.claude/settings.local.json
.nx/polygraph
.nx/self-healing
.nx/migrate-runs
.serena
.headroom*
.headroom

# generated by design-system build for Storybook
packages/storybook/.storybook/generated

# ad-hoc local verification harnesses (e.g. a scratch dev-server for manual a11y/browser checks)
.a11y-check/

# env files (never commit local secrets/config)
.env
.env.*
!.env.example

# loose incremental-build info outside dist/out-tsc
*.tsbuildinfo

# Playwright run artifacts
/playwright-report
/test-results

# svelte-package scratch output
.svelte-kit
