// Design-system conformance audit for @bixboards/core, data-table and data-list.
//
// Statically checks every component's `css` blocks against AGENTS.md / docs/design-system:
//
//   raw-color / raw-length / raw-duration / raw-z-index
//        No literal colors, px lengths, durations or global-scale z-indexes. Everything comes from
//        a design-system token. Exceptions: 1px hairlines, font-relative `em`, viewport units,
//        `@container` thresholds (custom properties are not allowed there), local stacking
//        integers <= 10 (every component that uses one isolates its stacking context), the
//        `max(1rem, <font token>)` 16px form-control font floor, and a line (or the line above it) that
//        carries a `ds-exempt: <reason>` comment (color-space data such as a hue ramp).
//   raw-font-token / unknown-text-style
//        Text takes its look from a design-system text style (`textStyle(hook, 'label-s')`,
//        `textFamily(hook, 'body')` from internal/text-style.ts, i.e. `--bx-type-*` tokens), never
//        from the loose `--bx-font-*` scale tokens. Only built-in styles may be named.
//   layout-media-query
//        Layout reflow uses `@container`, never `@media` (only user-preference and pointer
//        queries are allowed).
//   unknown-or-foreign-prop
//        Every `--bx-*` a component reads is a design-system token, one of its own hooks, or a
//        hook another component documents.
//   hook-shadowed-internally
//        A documented hook must not be (re)declared on an element inside the shadow tree: that
//        beats the consumer's value (use a private `--_*` property in variant rules instead).
//   undocumented-cssprop / documented-cssprop-unused / cssprop-not-namespaced
//        `@cssprop` JSDoc and the code agree, and every hook is `--bx-<tag>-*`.
//   undocumented-part / documented-part-missing
//        `@csspart` JSDoc and `part="..."` agree.
//
// Exits 1 when anything is found. Usage: node tools/audit-design-system.mts [--json]
import { readFileSync, readdirSync, statSync } from 'node:fs';
import { join, relative } from 'node:path';

const root = join(import.meta.dirname, '..');
const tokensCss = readFileSync(
  join(root, 'packages/design-system/dist/generated/tokens.css'),
  'utf8',
);
const tokens = new Set(
  [...tokensCss.matchAll(/(--bx-[a-z0-9-]+)\s*:/g)].map((m) => m[1]),
);

const SRC_DIRS = ['core', 'data-table', 'data-list'].map((p) =>
  join(root, 'packages', p, 'src'),
);

function walk(dir: string, out: string[] = []): string[] {
  for (const e of readdirSync(dir)) {
    const p = join(dir, e);
    if (statSync(p).isDirectory()) {
      if (e === 'node_modules' || e === 'fixtures') continue;
      walk(p, out);
    } else if (p.endsWith('.ts') && !/\.(test|d)\.ts$/.test(p)) out.push(p);
  }
  return out;
}

const files = SRC_DIRS.flatMap((d) => walk(d));
const sources = new Map(files.map((f) => [f, readFileSync(f, 'utf8')]));

// Hooks documented / consumed anywhere: components may forward each other's hooks (a group
// setting `--bx-avatar-size`, a tab reading `--bx-tab-group-indicator-color`).
const allDocumented = new Set<string>();
const allConsumed = new Set<string>();
for (const src of sources.values()) {
  for (const m of src.matchAll(/@cssprop\s+(--[a-z0-9-]+)/g))
    allDocumented.add(m[1]);
  for (const m of src.matchAll(/var\(\s*(--[a-z0-9-]+)/g))
    allConsumed.add(m[1]);
  // Hooks generated by textStyle()/textFamily() (internal/text-style.ts) are consumed too.
  for (const m of src.matchAll(/text(Style|Family)\(\s*'(--bx-[a-z0-9-]+)'/g))
    for (const prop of m[1] === 'Style'
      ? [
          'font-family',
          'font-size',
          'font-weight',
          'line-height',
          'letter-spacing',
        ]
      : ['font-family'])
      allConsumed.add(`${m[2]}-${prop}`);
}

/**
 * Lines (0-based) belonging to a declaration that carries a `ds-exempt: <reason>` comment: one
 * trailing the declaration on the same line as its `;`, or sitting anywhere inside/above it.
 */
function exemptDeclarationLines(text: string): Set<number> {
  const out = new Set<number>();
  const lineOf = (pos: number) => text.slice(0, pos).split('\n').length - 1;
  const cuts: number[] = [-1];
  let depth = 0;
  for (let i = 0; i < text.length; i++) {
    const ch = text[i];
    if (ch === '(') depth++;
    else if (ch === ')') depth--;
    else if (depth === 0 && (ch === ';' || ch === '{' || ch === '}'))
      cuts.push(i);
  }
  cuts.push(text.length);
  for (const m of text.matchAll(/ds-exempt:/g)) {
    const p = m.index!;
    let k = cuts.findIndex((c) => c >= p); // segment (cuts[k-1], cuts[k]] contains the comment
    const prevEnd = cuts[k - 1];
    const sameLineAsPrev =
      prevEnd >= 0 && !text.slice(prevEnd + 1, p).includes('\n');
    if (sameLineAsPrev && text[prevEnd] === ';') k -= 1; // trailing comment: the previous declaration
    const start = cuts[k - 1] + 1;
    const end = cuts[k];
    for (
      let l = lineOf(start);
      l <= lineOf(Math.min(end, text.length - 1));
      l++
    )
      out.add(l);
  }
  return out;
}

const NAMED_COLORS =
  /(?<![\w-])(white|black|red|green|blue|gray|grey|orange|yellow|purple|pink|silver|navy|teal)(?![\w-])/;

interface Finding {
  file: string;
  line: number;
  rule: string;
  text: string;
}
const findings: Finding[] = [];

for (const [file, src] of sources) {
  if (!/css`/.test(src)) continue;
  const rel = relative(root, file).replaceAll('\\', '/');
  const tag = /static override tagName = '(bx-[a-z-]+)'/.exec(src)?.[1];
  const own = tag ? `--${tag}-` : null;

  const lineOfIndex = (i: number) => src.slice(0, i).split('\n').length;
  const textHooks = new Map<string, { line: number; fallback: boolean }[]>();
  for (const m of src.matchAll(
    /textStyle\(\s*'(--bx-[a-z0-9-]+)'\s*,\s*'([a-z]+-[a-z0-9]+)'/g,
  )) {
    for (const prop of [
      'font-family',
      'font-size',
      'font-weight',
      'line-height',
      'letter-spacing',
    ])
      textHooks.set(`${m[1]}-${prop}`, [
        { line: lineOfIndex(m.index!), fallback: true },
      ]);
    if (!tokens.has(`--bx-type-${m[2]}-size`))
      findings.push({
        file: rel,
        line: lineOfIndex(m.index!),
        rule: 'unknown-text-style',
        text: m[2]!,
      });
  }
  for (const m of src.matchAll(
    /textFamily\(\s*'(--bx-[a-z0-9-]+)'\s*,\s*'([a-z]+)'/g,
  )) {
    textHooks.set(`${m[1]}-font-family`, [
      { line: lineOfIndex(m.index!), fallback: true },
    ]);
    if (!tokens.has(`--bx-type-${m[2]}-family`))
      findings.push({
        file: rel,
        line: lineOfIndex(m.index!),
        rule: 'unknown-text-style',
        text: m[2]!,
      });
  }

  const blocks: { text: string; line: number }[] = [];
  for (const m of src.matchAll(/css`([\s\S]*?)`/g)) {
    blocks.push({
      text: m[1],
      line: src.slice(0, m.index).split('\n').length,
    });
  }
  const add = (b: { line: number }, i: number, rule: string, text: string) =>
    findings.push({ file: rel, line: b.line + i, rule, text: text.trim() });

  const consumed = new Map<string, { line: number; fallback: boolean }[]>(
    textHooks,
  );
  const defined = new Set<string>();
  const definedInside = new Set<string>(); // by rules that target the shadow tree, not `:host`

  for (const b of blocks) {
    // Custom property consumption: scan the whole block since `var(` may wrap onto the next line.
    for (const m of b.text.matchAll(/var\(\s*(--[a-z0-9-]+)(\s*,)?/g)) {
      const arr = consumed.get(m[1]) ?? [];
      arr.push({
        line: b.line + b.text.slice(0, m.index).split('\n').length - 1,
        fallback: !!m[2],
      });
      consumed.set(m[1], arr);
    }
    for (const r of b.text.matchAll(/([^{}]+)\{([^{}]*)\}/g)) {
      const sel = r[1].trim().split(',')[0].trim();
      for (const d of r[2].matchAll(/(?:^|;|\n)\s*(--[a-z0-9-]+)\s*:/g)) {
        defined.add(d[1]);
        if (!/^:host(\([^)]*\))?$/.test(sel) && !sel.startsWith('@'))
          definedInside.add(d[1]);
      }
    }

    const lines = b.text
      .replace(/\/\*[\s\S]*?\*\//g, (c) => c.replace(/[^\n]/g, ' '))
      .split('\n');
    const rawLines = b.text.split('\n');
    const exemptLines = exemptDeclarationLines(b.text);
    lines.forEach((line, i) => {
      if (!line.trim()) return;
      const exempt = exemptLines.has(i);
      // strip var(--name so token names don't trip the literal checks
      const bare = line.replace(/var\(\s*--[a-z0-9-]+/g, 'var(');
      const raw = rawLines[i];

      if (!exempt) {
        if (
          /#[0-9a-fA-F]{3,8}\b/.test(bare) ||
          /\b(rgba?|hsla?|oklch|oklab|lab|lch|hwb)\(/.test(bare) ||
          (/(color|background|border|outline|fill|stroke|shadow)[a-z-]*\s*:/.test(
            bare,
          ) &&
            NAMED_COLORS.test(bare.split(':').slice(1).join(':')))
        )
          add(b, i, 'raw-color', raw);
      }

      if (/@container/.test(line)) return; // thresholds: custom properties are not allowed there
      for (const l of bare.matchAll(/(?<![\w.-])(-?\d*\.?\d+)(px|rem)\b/g)) {
        const n = parseFloat(l[1]);
        if (n === 0 || (l[2] === 'px' && n === 1)) continue; // hairline
        if (
          l[2] === 'rem' &&
          /max\(1rem, var\(--bx-font-[a-z0-9]+\)\)/.test(line)
        )
          continue;
        if (exempt) continue;
        add(b, i, `raw-length(${l[2]})`, raw);
        break;
      }
      if (
        /(?<![\w.-])\d*\.?\d+m?s\b/.test(bare) &&
        /(transition|animation|duration|delay)/.test(bare) &&
        !exempt
      )
        add(b, i, 'raw-duration', raw);
      const z = /z-index\s*:\s*(-?\d+)/.exec(bare);
      if (z && Math.abs(Number(z[1])) > 10) add(b, i, 'raw-z-index', raw);
      if (
        /var\(\s*--bx-font-(xs|s|m|l|xl|2xl|3xl|weight-|leading-|family-)/.test(
          line,
        ) &&
        !exempt
      )
        add(b, i, 'raw-font-token', raw);
      if (/font-weight\s*:\s*\d{3}/.test(bare))
        add(b, i, 'raw-font-weight', raw);
      if (
        /font-family\s*:/.test(bare) &&
        !/var\(/.test(bare) &&
        !/inherit/.test(bare)
      )
        add(b, i, 'raw-font-family', raw);
      if (
        /@media/.test(bare) &&
        !/prefers-reduced-motion|forced-colors|prefers-color-scheme|pointer|hover|prefers-contrast|print/.test(
          bare,
        )
      )
        add(b, i, 'layout-media-query', raw);
    });
  }

  // Custom property hygiene.
  for (const [name, uses] of consumed) {
    if (!name.startsWith('--bx-') || tokens.has(name)) continue;
    const isOwn = own && name.startsWith(own);
    if (!isOwn && !allDocumented.has(name))
      for (const u of uses)
        findings.push({
          file: rel,
          line: u.line,
          rule: 'unknown-or-foreign-prop',
          text: name,
        });
  }

  const documented = new Set(
    [...src.matchAll(/@cssprop\s+(--[a-z0-9-]+)/g)].map((m) => m[1]),
  );
  for (const [name, uses] of consumed) {
    if (!own || !name.startsWith(own)) continue;
    const publicInput = uses.some((u) => u.fallback) && !defined.has(name);
    // A var() with a fallback is a public hook by pattern, documented or not: it must not be
    // redeclared on an element inside the shadow tree either.
    if (
      uses.some((u) => u.fallback) &&
      definedInside.has(name) &&
      !documented.has(name)
    )
      findings.push({
        file: rel,
        line: uses[0].line,
        rule: 'hook-shadowed-internally',
        text: name,
      });
    if (publicInput && !documented.has(name) && !allDocumented.has(name))
      findings.push({
        file: rel,
        line: uses[0].line,
        rule: 'undocumented-cssprop',
        text: name,
      });
    if (
      !defined.has(name) &&
      uses.every((u) => !u.fallback) &&
      !documented.has(name)
    )
      findings.push({
        file: rel,
        line: uses[0].line,
        rule: 'prop-without-fallback',
        text: name,
      });
  }
  for (const name of documented) {
    if (definedInside.has(name))
      findings.push({
        file: rel,
        line: 0,
        rule: 'hook-shadowed-internally',
        text: name,
      });
    // A hook counts as used if any component reads it, or this file sets it from script
    // (e.g. `style.setProperty('--bx-popup-auto-size-available-width', ...)`).
    const setFromScript =
      src.split(`'${name}'`).length > 1 || src.includes(`${name}:`);
    if (!allConsumed.has(name) && !defined.has(name) && !setFromScript)
      findings.push({
        file: rel,
        line: 0,
        rule: 'documented-cssprop-unused',
        text: name,
      });
    if (own && !name.startsWith(own) && !/^--bx-(popup)-/.test(name))
      findings.push({
        file: rel,
        line: 0,
        rule: 'cssprop-not-namespaced',
        text: name,
      });
  }

  // @csspart docs vs part="..." in templates.
  const docParts = new Set(
    [...src.matchAll(/@csspart\s+([a-z0-9-]+)/g)].map((m) => m[1]),
  );
  const usedParts = new Set<string>();
  let dynamic = false;
  // part="a b", part="${cond ? 'a' : 'b'}" and part=${expr}: collect every literal word, and
  // mark expression-built names as dynamic so unused-doc checks are skipped.
  for (const m of src.matchAll(/\bpart=("[^"]*"|'[^']*'|\$\{[^}]*\})/g)) {
    const v = m[1];
    if (v.includes('${')) {
      dynamic = true;
      for (const lit of v.matchAll(/'([a-z][a-z0-9 -]*)'/g))
        for (const p of lit[1].split(/\s+/)) if (p) usedParts.add(p);
    } else for (const p of v.slice(1, -1).split(/\s+/)) if (p) usedParts.add(p);
  }
  for (const m of src.matchAll(/exportparts="([^"]+)"/g))
    for (const p of m[1].split(',')) usedParts.add(p.trim().split(':')[0]);
  if (own) {
    for (const p of usedParts)
      if (!docParts.has(p))
        findings.push({
          file: rel,
          line: 0,
          rule: 'undocumented-part',
          text: p,
        });
    if (!dynamic)
      for (const p of docParts)
        if (!usedParts.has(p))
          findings.push({
            file: rel,
            line: 0,
            rule: 'documented-part-missing',
            text: p,
          });
  }
}

if (process.argv.includes('--json'))
  console.log(JSON.stringify(findings, null, 1));
else {
  const byRule = new Map<string, Finding[]>();
  for (const f of findings)
    byRule.set(f.rule, [...(byRule.get(f.rule) ?? []), f]);
  for (const [rule, fs] of [...byRule].sort()) {
    console.log(`\n## ${rule} (${fs.length})`);
    for (const f of fs) console.log(`${f.file}:${f.line}  ${f.text}`);
  }
  console.log(`\n${findings.length} finding(s)`);
}
process.exit(findings.length ? 1 : 0);
