// Generates the framework wrappers from the Custom Elements Manifests (tools/cem/generate.mts).
//
//   node tools/wrappers/generate.mts [react|angular|svelte ...]   # default: all three
//   node tools/wrappers/generate.mts --check [...]                # fail when generated output is stale
//
// Nothing here knows about individual components: everything comes from the manifests, so a wrapper
// cannot drift from its element (docs/features/_conventions.md §8). Output goes to
// packages/<framework>/src/generated and is committed; `--check` guards it in CI.

import fs from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

const root = path.resolve(
  path.dirname(fileURLToPath(import.meta.url)),
  '../..',
);
const CEM_PACKAGES = ['core', 'data-list', 'data-table'];

interface Param {
  name: string;
  type: { text: string };
  optional?: boolean;
}
interface El {
  tag: string;
  className: string;
  /** Import specifier of the element's package entry, e.g. `@bixant/core/select`. */
  specifier: string;
  formAssociated: boolean;
  description: string;
  props: {
    name: string;
    attribute?: string;
    type: string;
    description?: string;
  }[];
  events: { name: string; description?: string }[];
  slots: { name: string; description?: string }[];
  methods: {
    name: string;
    description?: string;
    params: Param[];
    returns: string;
  }[];
}

// --- Manifest -> model -------------------------------------------------------------------------

function load(): El[] {
  const elements: El[] = [];
  for (const pkg of CEM_PACKAGES) {
    const file = path.join(root, 'packages', pkg, 'custom-elements.json');
    if (!fs.existsSync(file))
      throw new Error(
        `${file} missing — run node tools/cem/generate.mts first`,
      );
    const manifest = JSON.parse(fs.readFileSync(file, 'utf8'));
    for (const mod of manifest.modules) {
      // src/<dir>/<file>.ts  ->  @bixant/<pkg>/<dir>
      const dir = (mod.path as string).split('/')[1]!;
      for (const d of mod.declarations) {
        if (!d.tagName) continue;
        elements.push({
          tag: d.tagName,
          className: d.name,
          specifier: `@bixant/${pkg}/${dir}`,
          formAssociated: !!d.formAssociated,
          description: d.description ?? '',
          props: (d.members ?? [])
            .filter((m: { kind: string }) => m.kind === 'field')
            .map(
              (m: {
                name: string;
                attribute?: string;
                type: { text: string };
                description?: string;
              }) => ({
                name: m.name,
                attribute: m.attribute,
                type: m.type.text,
                description: m.description,
              }),
            ),
          events: d.events ?? [],
          slots: d.slots ?? [],
          methods: (d.members ?? [])
            .filter((m: { kind: string }) => m.kind === 'method')
            .map(
              (m: {
                name: string;
                description?: string;
                parameters: Param[];
                return: { type: { text: string } };
              }) => ({
                name: m.name,
                description: m.description,
                params: m.parameters,
                returns: m.return.type.text,
              }),
            ),
        });
      }
    }
  }
  return elements.sort((a, b) => a.tag.localeCompare(b.tag));
}

const pascal = (s: string): string =>
  s.replace(/(^|-)(\w)/g, (_, __, c: string) => c.toUpperCase());
const camel = (s: string): string => {
  const p = pascal(s);
  return p[0]!.toLowerCase() + p.slice(1);
};
/** Events with no dash are native (`input`, `change`, `focus`): frameworks already handle those. */
const isNative = (event: string): boolean => !event.includes('-');
const q = (s: string): string => `'${s.replace(/'/g, "\\'")}'`;
const doc = (text: string | undefined, indent = ''): string =>
  text
    ? `${indent}/**\n${text
        .replace(/\*\//g, '*\\/')
        .split('\n')
        .map((l) => `${indent} * ${l}`.trimEnd())
        .join('\n')}\n${indent} */\n`
    : '';
const oneLine = (s: string | undefined): string =>
  (s ?? '').replace(/\s+/g, ' ').trim();

const HEADER =
  '// Generated by tools/wrappers/generate.mts from the Custom Elements Manifests. Do not edit.\n';

type Output = Map<string, string>;

// --- React -------------------------------------------------------------------------------------

function react(els: El[]): Output {
  const out: Output = new Map();
  for (const el of els) {
    const name = el.className;
    const props = el.props.map((p) => q(p.name)).join(' | ') || 'never';
    const slotUnion = el.slots.length
      ? el.slots.map((s) => q(s.name || 'default')).join(' | ')
      : 'never';
    const eventProps = el.events.map((e) => ({
      prop: isNative(e.name) ? `on${pascal(e.name)}` : `on${pascal(e.name)}`,
      name: e.name,
      description: oneLine(e.description),
    }));
    const body = `${HEADER}'use client';
import ${q(el.specifier)};
import type { ${name} as ${name}Element } from ${q(el.specifier)};
import { createComponent, type WrapperProps } from '../create-component.ts';

export type { ${name}Element };

/** Named slots of \`<${el.tag}>\`; set one with the \`slot\` attribute on a child. */
export type ${name}Slot = ${slotUnion};

export interface ${name}Events {
${eventProps
  .map(
    (e) =>
      `${e.description ? `  /** ${e.description.replace(/\*\//g, '*\\/')} */\n` : ''}  ${e.prop}?: (event: CustomEvent) => void;`,
  )
  .join('\n')}
}

export type ${name}Props = WrapperProps<
  Partial<Pick<${name}Element, ${props}>>,
  ${name}Events
>;

${doc(el.description.split('\n\n')[0])}export const ${name} = createComponent<${name}Element, ${name}Props>({
  tagName: ${q(el.tag)},
  displayName: ${q(name)},
  properties: [${el.props.map((p) => `{ name: ${q(p.name)}${p.attribute ? `, attribute: ${q(p.attribute)}` : ''} }`).join(', ')}],
  events: { ${eventProps.map((e) => `${e.prop}: ${q(e.name)}`).join(', ')} },
});
`;
    out.set(`generated/${el.tag}.ts`, body);
  }
  out.set(
    'index.ts',
    `${HEADER}export { createComponent, type WrapperProps } from './create-component.ts';\n${els
      .map((el) => `export * from './generated/${el.tag}.ts';`)
      .join('\n')}\n`,
  );
  return out;
}

// --- Angular -----------------------------------------------------------------------------------

const CVA_INPUT_LIKE = new Set([
  'bx-input',
  'bx-textarea',
  'bx-number-input',
  'bx-slider',
]);

function angular(els: El[]): Output {
  const out: Output = new Map();
  for (const el of els) {
    const name = el.className;
    const cls = `${name}Component`;
    const outputs = el.events.filter((e) => !isNative(e.name));
    const hasChecked = el.props.some((p) => p.name === 'checked');
    const valueProp = hasChecked ? 'checked' : 'value';
    const cvaEvent = hasChecked
      ? 'change'
      : CVA_INPUT_LIKE.has(el.tag)
        ? 'input'
        : 'change';
    const cva = el.formAssociated && el.props.some((p) => p.name === valueProp);

    const inputs = el.props
      .map(
        (p) => `${doc(oneLine(p.description), '  ')}  @Input()
  set ${p.name}(value: ${name}Element[${q(p.name)}]) {
    this.element.${p.name} = value;
  }
  get ${p.name}(): ${name}Element[${q(p.name)}] {
    return this.element.${p.name};
  }`,
      )
      .join('\n\n');

    const outs = outputs
      .map(
        (e) =>
          `${doc(oneLine(e.description), '  ')}  @Output() readonly ${camel(e.name)} = new EventEmitter<CustomEvent>();`,
      )
      .join('\n');

    // Signatures are derived from the element class itself, so parameter types never have to be
    // re-declared (or imported) in the wrapper and cannot drift.
    const methods = el.methods
      .map(
        (m) => `${doc(oneLine(m.description), '  ')}  ${m.name}(...args: Parameters<${name}Element[${q(m.name)}]>): ReturnType<${name}Element[${q(m.name)}]> {
    return this.element.${m.name}(...args);
  }`,
      )
      .join('\n\n');

    const body = `${HEADER}import {
  ChangeDetectionStrategy,
  Component,
  DestroyRef,
  ElementRef,
  EventEmitter,
  Input,
  Output,
  ViewEncapsulation,
  inject,${cva ? '\n  forwardRef,' : ''}
} from '@angular/core';
${cva ? "import { NG_VALUE_ACCESSOR, type ControlValueAccessor } from '@angular/forms';\n" : ''}import ${q(el.specifier)};
import type { ${name} as ${name}Element } from ${q(el.specifier)};

${doc(el.description.split('\n\n')[0])}@Component({
  selector: ${q(el.tag)},
  standalone: true,
  template: '<ng-content></ng-content>',
  encapsulation: ViewEncapsulation.None,
  changeDetection: ChangeDetectionStrategy.OnPush,${
    cva
      ? `
  providers: [
    { provide: NG_VALUE_ACCESSOR, useExisting: forwardRef(() => ${cls}), multi: true },
  ],`
      : ''
  }
})
export class ${cls}${cva ? ' implements ControlValueAccessor' : ''} {
  /** The underlying custom element. */
  readonly element = inject<ElementRef<${name}Element>>(ElementRef).nativeElement;
${inputs ? `\n${inputs}\n` : ''}${outs ? `\n${outs}\n` : ''}
  constructor() {
    const destroyRef = inject(DestroyRef);
${outputs
  .map(
    (
      e,
    ) => `    const on${pascal(e.name)} = (event: Event): void => this.${camel(e.name)}.emit(event as CustomEvent);
    this.element.addEventListener(${q(e.name)}, on${pascal(e.name)});
    destroyRef.onDestroy(() => this.element.removeEventListener(${q(e.name)}, on${pascal(e.name)}));`,
  )
  .join('\n')}${cva ? '    destroyRef.onDestroy(() => this.removeListeners());' : outputs.length === 0 ? '    void destroyRef;' : ''}
  }
${methods ? `\n${methods}\n` : ''}${
      cva
        ? `
  // --- ControlValueAccessor ---
  private onTouched: () => void = () => undefined;
  private listeners: [string, EventListener][] = [];

  writeValue(value: unknown): void {
    this.element.${valueProp} = (value ?? ${valueProp === 'checked' ? 'false' : "''"}) as ${name}Element[${q(valueProp)}];
  }

  registerOnChange(fn: (value: unknown) => void): void {
    this.removeListeners();
    const change = (): void => fn(this.element.${valueProp});
    const touched = (): void => this.onTouched();
    this.listeners = [
      [${q(cvaEvent)}, change],
      ['blur', touched],
    ];
    for (const [event, listener] of this.listeners) this.element.addEventListener(event, listener);
  }

  registerOnTouched(fn: () => void): void {
    this.onTouched = fn;
  }

  setDisabledState(isDisabled: boolean): void {
    this.element.disabled = isDisabled;
  }

  private removeListeners(): void {
    for (const [event, listener] of this.listeners) this.element.removeEventListener(event, listener);
    this.listeners = [];
  }
`
        : ''
    }}
`;
    out.set(`generated/${el.tag}.ts`, body);
  }
  out.set(
    'index.ts',
    `${HEADER}${els.map((el) => `export * from './generated/${el.tag}.ts';`).join('\n')}\n`,
  );
  return out;
}

// --- Svelte ------------------------------------------------------------------------------------

function svelte(els: El[]): Output {
  const out: Output = new Map();
  for (const el of els) {
    const name = el.className;
    const outputs = el.events.filter((e) => !isNative(e.name));
    const hasChecked = el.props.some((p) => p.name === 'checked');
    const bindables: { prop: string; events: string[] }[] = [];
    if (el.props.some((p) => p.name === 'value'))
      bindables.push({ prop: 'value', events: ['input', 'change'] });
    if (hasChecked) bindables.push({ prop: 'checked', events: ['change'] });
    const hasShow =
      el.events.some((e) => e.name === 'bx-after-show') &&
      el.events.some((e) => e.name === 'bx-after-hide');
    if (el.props.some((p) => p.name === 'open') && hasShow)
      bindables.push({
        prop: 'open',
        events: ['bx-after-show', 'bx-after-hide'],
      });
    const bindNames = new Set(bindables.map((b) => b.prop));
    const plain = el.props.filter((p) => !bindNames.has(p.name));
    const eventProps = outputs.map((e) => ({
      prop: `on${pascal(e.name)}`,
      name: e.name,
      description: oneLine(e.description),
    }));
    const propList = el.props.map((p) => q(p.name)).join(' | ') || 'never';

    // Locals are `_`-prefixed so element properties named like runes or keywords (`effect`,
    // `for`, `sync`, ...) never collide with Svelte syntax or the runtime helper imports.
    const destructure = [
      ...bindables.map((b) => `${b.prop}: _${b.prop} = $bindable()`),
      'element = $bindable()',
      'children',
      ...eventProps.map((e) => `${e.prop}: _${e.prop}`),
      ...plain.map((p) => `${p.name}: _${p.name}`),
      '...rest',
    ].join(',\n    ');

    const syncObject = el.props.map((p) => `${q(p.name)}: _${p.name}`).join(', ');
    const helpers = [
      bindables.length ? 'bind as bindProps' : '',
      eventProps.length ? 'on as onEvents' : '',
      'sync as syncProps',
    ]
      .filter(Boolean)
      .join(', ');
    const body = `<!-- ${HEADER.trim()} -->
<script lang="ts" module>
  import type { ${name} as ${name}Element } from ${q(el.specifier)};
  import type { Snippet } from 'svelte';
  import type { HTMLAttributes } from 'svelte/elements';

  /** Named slots of \`<${el.tag}>\`; set one with the \`slot\` attribute on a child. */
  export type ${name}Slot = ${el.slots.length ? el.slots.map((s) => q(s.name || 'default')).join(' | ') : 'never'};

  export interface ${name}Events {
${eventProps.map((e) => `${e.description ? `    /** ${e.description.replace(/\*\//g, '*\\/')} */\n` : ''}    ${e.prop}?: (event: CustomEvent) => void;`).join('\n')}
  }

  export type ${name}Props = Partial<Pick<${name}Element, ${propList}>> &
    ${name}Events & {
      /** The underlying custom element (\`bind:element\`). */
      element?: ${name}Element | undefined;
      children?: Snippet;
    } & Omit<HTMLAttributes<HTMLElement>, keyof ${name}Events | ${propList} | 'children'>;
</script>

<script lang="ts">
  import ${q(el.specifier)};
  import { ${helpers} } from '../runtime.ts';

  let {
    ${destructure}
  }: ${name}Props = $props();

  $effect(() => {
    if (element) syncProps(element, { ${syncObject} });
  });
${
  eventProps.length
    ? `
  $effect(() => {
    if (!element) return;
    return onEvents(element, { ${eventProps.map((e) => `${q(e.name)}: _${e.prop}`).join(', ')} });
  });
`
    : ''
}${
      bindables.length
        ? `
  $effect(() => {
    if (!element) return;
    return bindProps(element, [
${bindables.map((b) => `      [${q(b.prop)}, [${b.events.map(q).join(', ')}], (next) => (_${b.prop} = next as typeof _${b.prop})],`).join('\n')}
    ]);
  });
`
        : ''
    }</script>

<${el.tag} bind:this={element} {...rest}>
  {@render children?.()}
</${el.tag}>
`;
    out.set(`generated/${name}.svelte`, body);
  }
  out.set(
    'index.ts',
    `${HEADER}${els
      .map(
        (el) =>
          `export { default as ${el.className} } from './generated/${el.className}.svelte';\nexport type { ${el.className}Props, ${el.className}Slot } from './generated/${el.className}.svelte';`,
      )
      .join('\n')}\n`,
  );
  return out;
}

// --- Driver ------------------------------------------------------------------------------------

const generators: Record<string, (els: El[]) => Output> = {
  react,
  angular,
  svelte,
};
const args = process.argv.slice(2);
const check = args.includes('--check');
const targets = args.filter((a) => !a.startsWith('--'));
const selected = targets.length ? targets : Object.keys(generators);
const elements = load();
let stale = false;

for (const target of selected) {
  const generate = generators[target];
  if (!generate) throw new Error(`unknown target ${target}`);
  const srcDir = path.join(root, 'packages', target, 'src');
  const files = generate(elements);
  if (check) {
    for (const [rel, content] of files) {
      const file = path.join(srcDir, rel);
      if (!fs.existsSync(file) || fs.readFileSync(file, 'utf8') !== content) {
        console.error(`stale: ${path.relative(root, file)}`);
        stale = true;
      }
    }
    continue;
  }
  const genDir = path.join(srcDir, 'generated');
  fs.rmSync(genDir, { recursive: true, force: true });
  fs.mkdirSync(genDir, { recursive: true });
  for (const [rel, content] of files) {
    const file = path.join(srcDir, rel);
    fs.mkdirSync(path.dirname(file), { recursive: true });
    fs.writeFileSync(file, content);
  }
  console.log(
    `${target}: ${elements.length} elements -> ${path.relative(root, srcDir)}`,
  );
}
if (stale) process.exit(1);
