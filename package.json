{
  "name": "@org/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "test": "nx run-many -t test",
    "test:stories": "nx run storybook:test-stories",
    "typecheck": "nx run-many -t typecheck",
    "build": "nx run-many -t build tokens build-storybook",
    "validate": "nx run-many -t validate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm generate:check && pnpm audit:design-system && nx run-many -t typecheck test validate build tokens build-storybook",
    "storybook": "pnpm --dir packages/storybook run storybook",
    "build-storybook": "pnpm --dir packages/storybook run build-storybook",
    "generate": "node tools/cem/generate.mts && node tools/wrappers/generate.mts && node tools/docs/sync-css-api.mts",
    "generate:check": "node tools/cem/generate.mts --check && node tools/wrappers/generate.mts --check && node tools/docs/sync-css-api.mts --check",
    "audit:design-system": "node tools/audit-design-system.mts"
  },
  "private": true,
  "devDependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@nx/js": "23.2.0",
    "@open-wc/testing": "^5.0.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/web-components-vite": "^10.6.1",
    "@sveltejs/package": "^2.3.0",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "@web/dev-server-esbuild": "^2.0.0",
    "@web/test-runner": "^1.0.0",
    "@web/test-runner-commands": "^1.0.1",
    "@web/test-runner-playwright": "^1.0.0",
    "axe-core": "^4.13.0",
    "esbuild": "^0.25.0",
    "lit": "^3.3.3",
    "nx": "23.2.0",
    "playwright": "^1.63.0",
    "prettier": "^3.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rxjs": "^7.8.0",
    "storybook": "^10.6.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.4.1"
}
