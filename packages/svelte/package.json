{
  "name": "@bixboards/svelte",
  "version": "0.0.0",
  "description": "Svelte 5 components for every Bixboards element (typed props, callback events, bindable value/open/checked), generated from the Custom Elements Manifests.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.svelte"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*.svelte": {
      "types": "./dist/generated/*.svelte.d.ts",
      "svelte": "./dist/generated/*.svelte",
      "default": "./dist/generated/*.svelte"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "node ../../tools/wrappers/generate.mts svelte",
    "package": "svelte-package -i src -o dist --tsconfig tsconfig.lib.json",
    "check": "svelte-check --tsconfig tsconfig.json"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "dependencies": {
    "@bixboards/core": "workspace:*",
    "@bixboards/data-list": "workspace:*",
    "@bixboards/data-table": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.3.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0"
  }
}
