---
import '../styles/global.css';
import { manifest } from '../data/manifest.ts';
interface Props {
  title: string;
  description?: string;
  /** Elements the page only uses from script (e.g. `bx-toast`); loaded without being in the DOM. */
  load?: string[];
}
const {
  title,
  description = 'Bixboards: framework-agnostic web components with token-driven theming.',
  load = [],
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const tagKeys = Object.fromEntries(
  [...manifest().values()].map((e) => [e.tag, `${e.pkg}/${e.dir}`]),
);
const nav = [
  ['Getting started', '/getting-started/'],
  ['Components', '/components/'],
  ['Templates', '/templates/'],
] as const;
const path = Astro.url.pathname.replace(base, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      try {
        var t = localStorage.getItem('theme');
        if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'board-dark' : 'board';
        document.documentElement.dataset.theme = t;
      } catch (e) {
        document.documentElement.dataset.theme = 'board';
      }
    </script>
  </head>
  <body data-bx-load={load.join(' ')}>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site">
      <div class="wrap">
        <a class="logo" href={`${base}/`}>Bixboards</a>
        <nav aria-label="Main">
          {
            nav.map(([label, href]) => (
              <a href={`${base}${href}`} aria-current={path.startsWith(href) ? 'page' : undefined}>
                {label}
              </a>
            ))
          }
        </nav>
        <bx-button id="theme-toggle" appearance="outlined" size="s">Toggle theme</bx-button>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site"><div class="wrap">Bixboards. MIT licensed.</div></footer>
    <script id="bx-tag-keys" type="application/json" set:html={JSON.stringify(tagKeys)} />
    <script>
      import '../scripts/autoload.ts';

      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const next =
          document.documentElement.dataset.theme === 'board-dark' ? 'board' : 'board-dark';
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {
          /* storage unavailable */
        }
      });
    </script>
  </body>
</html>
