---
import Base from '../layouts/Base.astro';
import { components } from '../data/site';
const categories = [...new Set(components.map((c) => c.category))];
---

<Base title="Components · Bixboards">
  <section class="block">
    <div class="wrap">
      <h2>Components</h2>
      <p class="lead">Dashed items are planned.</p>
      {
        categories.map((cat) => (
          <>
            <h3>{cat}</h3>
            <div class="chips">
              {components
                .filter((c) => c.category === cat)
                .map((c) => (
                  <span class={`chip ${c.status}`}>
                    <code>{c.tag}</code>
                  </span>
                ))}
            </div>
          </>
        ))
      }
    </div>
  </section>
</Base>
