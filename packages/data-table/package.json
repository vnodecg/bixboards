{
  "name": "@bixant/data-table",
  "version": "0.0.0",
  "description": "Bixant virtualized enterprise data table (bx-data-table), built on core VirtualizerController.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/data-table/index.js"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./data-table": {
      "types": "./dist/data-table/index.d.ts",
      "default": "./dist/data-table/index.js"
    },
    "./data-table/define": {
      "types": "./dist/data-table/define.d.ts",
      "default": "./dist/data-table/define.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@bixant/core": "workspace:*",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@bixant/design-system": "workspace:*"
  }
}
