{
  "name": "@bixboards/react",
  "version": "0.0.0",
  "description": "React wrappers for every Bixboards element, generated from the Custom Elements Manifests.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/generated/*.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/generated/*.d.ts",
      "default": "./dist/generated/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "node ../../tools/wrappers/generate.mts react"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@bixboards/core": "workspace:*",
    "@bixboards/data-list": "workspace:*",
    "@bixboards/data-table": "workspace:*"
  }
}
