{
  "$schema": "../schema/foundation.schema.json",
  "scale": "1",
  "fluid": {
    "min": "0.875rem",
    "max": "1.125rem",
    "preferred": "0.8125rem + 0.25vi"
  },
  "unit": "calc(clamp({fluid.min}, {fluid.preferred}, {fluid.max}) * {scale})",
  "target": { "min": "1.5rem" },
  "space": {
    "2xs": "calc({unit} * 0.25)",
    "xs": "calc({unit} * 0.5)",
    "s": "calc({unit} * 0.75)",
    "m": "{unit}",
    "l": "calc({unit} * 1.5)",
    "xl": "calc({unit} * 2)",
    "2xl": "calc({unit} * 3)",
    "3xl": "calc({unit} * 4)"
  },
  "font": {
    "family": {
      "sans": "'Inter Variable', Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
      "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
    },
    "xs": "calc({unit} * 0.75)",
    "s": "calc({unit} * 0.875)",
    "m": "{unit}",
    "l": "calc({unit} * 1.125)",
    "xl": "calc({unit} * 1.25)",
    "2xl": "calc({unit} * 1.5)",
    "3xl": "calc({unit} * 2)",
    "weight": {
      "regular": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700"
    },
    "leading": { "tight": "1.25", "normal": "1.55" }
  },
  "radius": {
    "s": "calc({unit} * 0.375)",
    "m": "calc({unit} * 0.5)",
    "l": "calc({unit} * 0.75)",
    "pill": "9999px"
  },
  "control": {
    "height": {
      "s": "calc({unit} * 2)",
      "m": "calc({unit} * 2.5)",
      "l": "calc({unit} * 3)"
    }
  },
  "border": { "width": "1px", "width-strong": "2px" },
  "focus": { "ring-offset": "2px" },
  "shadow": {
    "s": "0 1px 2px rgba(23, 25, 60, 0.05), 0 1px 3px rgba(23, 25, 60, 0.04)",
    "m": "0 2px 4px rgba(23, 25, 60, 0.04), 0 8px 20px rgba(23, 25, 60, 0.08)",
    "l": "0 4px 8px rgba(23, 25, 60, 0.05), 0 20px 48px rgba(23, 25, 60, 0.14)"
  },
  "motion": {
    "duration": { "fast": "120ms", "base": "200ms", "slow": "360ms" },
    "easing": { "standard": "cubic-bezier(0.22, 1, 0.36, 1)" }
  },
  "z": {
    "dropdown": "1000",
    "sticky": "1100",
    "overlay": "1200",
    "modal": "1300",
    "tooltip": "1400"
  },
  "safe-area": {
    "inset": {
      "top": "env(safe-area-inset-top, 0px)",
      "right": "env(safe-area-inset-right, 0px)",
      "bottom": "env(safe-area-inset-bottom, 0px)",
      "left": "env(safe-area-inset-left, 0px)"
    }
  },
  "$coarse": {
    "target": { "min": "2.75rem" }
  }
}
