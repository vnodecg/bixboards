{
  "$schema": "../schema/foundation.schema.json",
  "scale": "1",
  "fluid": {
    "min": "0.9375rem",
    "max": "1.1875rem",
    "preferred": "0.875rem + 0.25vi"
  },
  "unit": "calc(clamp({fluid.min}, {fluid.preferred}, {fluid.max}) * {scale})",
  "target": {
    "min": "1.5rem"
  },
  "space": {
    "2xs": "calc({unit} * 0.25)",
    "xs": "calc({unit} * 0.5)",
    "s": "calc({unit} * 0.75)",
    "m": "{unit}",
    "l": "calc({unit} * 1.5)",
    "xl": "calc({unit} * 2)",
    "2xl": "calc({unit} * 3)",
    "3xl": "calc({unit} * 4)"
  },
  "font": {
    "family": {
      "sans": "'Inter Variable', Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
      "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
    },
    "floor": "1rem",
    "xs": "calc({unit} * 0.75)",
    "s": "calc({unit} * 0.875)",
    "m": "{unit}",
    "l": "calc({unit} * 1.125)",
    "xl": "calc({unit} * 1.25)",
    "2xl": "calc({unit} * 1.5)",
    "3xl": "calc({unit} * 2)",
    "weight": {
      "regular": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700"
    },
    "leading": {
      "tight": "1.3",
      "snug": "1.5",
      "normal": "1.65"
    }
  },
  "type": {
    "display": {
      "family": "{font.family.sans}",
      "l": {
        "size": "calc({unit} * 3)",
        "weight": "{font.weight.semibold}",
        "leading": "{font.leading.tight}",
        "tracking": "-0.02em"
      },
      "m": {
        "size": "calc({unit} * 2.5)",
        "weight": "{font.weight.semibold}",
        "leading": "{font.leading.tight}",
        "tracking": "-0.02em"
      }
    },
    "heading": {
      "family": "{font.family.sans}",
      "xl": {
        "size": "{font.3xl}",
        "weight": "{font.weight.semibold}",
        "leading": "{font.leading.tight}",
        "tracking": "-0.01em"
      },
      "l": {
        "size": "{font.2xl}",
        "weight": "{font.weight.semibold}",
        "leading": "{font.leading.tight}",
        "tracking": "-0.01em"
      },
      "m": {
        "size": "{font.xl}",
        "weight": "{font.weight.semibold}",
        "leading": "{font.leading.tight}",
        "tracking": "0em"
      },
      "s": {
        "size": "{font.l}",
        "weight": "{font.weight.semibold}",
        "leading": "{font.leading.tight}",
        "tracking": "0em"
      },
      "xs": {
        "size": "{font.m}",
        "weight": "{font.weight.semibold}",
        "leading": "{font.leading.tight}",
        "tracking": "0em"
      }
    },
    "body": {
      "family": "{font.family.sans}",
      "l": {
        "size": "{font.l}",
        "weight": "{font.weight.regular}",
        "leading": "{font.leading.normal}",
        "tracking": "0em"
      },
      "m": {
        "size": "{font.m}",
        "weight": "{font.weight.regular}",
        "leading": "{font.leading.normal}",
        "tracking": "0em"
      },
      "s": {
        "size": "{font.s}",
        "weight": "{font.weight.regular}",
        "leading": "{font.leading.snug}",
        "tracking": "0em"
      }
    },
    "label": {
      "family": "{font.family.sans}",
      "l": {
        "size": "{font.l}",
        "weight": "{font.weight.medium}",
        "leading": "{font.leading.tight}",
        "tracking": "0em"
      },
      "m": {
        "size": "{font.m}",
        "weight": "{font.weight.medium}",
        "leading": "{font.leading.tight}",
        "tracking": "0em"
      },
      "s": {
        "size": "{font.s}",
        "weight": "{font.weight.medium}",
        "leading": "{font.leading.tight}",
        "tracking": "0em"
      },
      "xs": {
        "size": "{font.xs}",
        "weight": "{font.weight.medium}",
        "leading": "{font.leading.tight}",
        "tracking": "0em"
      }
    },
    "caption": {
      "family": "{font.family.sans}",
      "m": {
        "size": "{font.s}",
        "weight": "{font.weight.regular}",
        "leading": "{font.leading.snug}",
        "tracking": "0em"
      },
      "s": {
        "size": "{font.xs}",
        "weight": "{font.weight.regular}",
        "leading": "{font.leading.snug}",
        "tracking": "0em"
      }
    },
    "code": {
      "family": "{font.family.mono}",
      "m": {
        "size": "{font.m}",
        "weight": "{font.weight.regular}",
        "leading": "{font.leading.normal}",
        "tracking": "0em"
      },
      "s": {
        "size": "{font.s}",
        "weight": "{font.weight.regular}",
        "leading": "{font.leading.snug}",
        "tracking": "0em"
      }
    },
    "field": {
      "family": "{font.family.sans}",
      "l": {
        "size": "{font.l}",
        "weight": "{font.weight.regular}",
        "leading": "{font.leading.tight}",
        "tracking": "0em"
      },
      "m": {
        "size": "{font.m}",
        "weight": "{font.weight.regular}",
        "leading": "{font.leading.tight}",
        "tracking": "0em"
      },
      "s": {
        "size": "{font.s}",
        "weight": "{font.weight.regular}",
        "leading": "{font.leading.tight}",
        "tracking": "0em"
      }
    }
  },
  "radius": {
    "s": "calc({unit} * 0.5)",
    "m": "calc({unit} * 0.75)",
    "l": "calc({unit} * 1)",
    "pill": "9999px"
  },
  "control": {
    "height": {
      "s": "calc({unit} * 2.125)",
      "m": "calc({unit} * 2.625)",
      "l": "calc({unit} * 3.125)"
    }
  },
  "border": {
    "width": "1px",
    "width-strong": "2px"
  },
  "focus": {
    "ring-offset": "2px"
  },
  "shadow": {
    "s": "0 1px 2px rgba(30, 38, 50, 0.04), 0 1px 3px rgba(30, 38, 50, 0.03)",
    "m": "0 2px 6px rgba(30, 38, 50, 0.03), 0 10px 28px rgba(30, 38, 50, 0.06)",
    "l": "0 4px 12px rgba(30, 38, 50, 0.04), 0 24px 56px rgba(30, 38, 50, 0.1)"
  },
  "motion": {
    "duration": {
      "fast": "160ms",
      "base": "260ms",
      "slow": "480ms",
      "spin": "1100ms",
      "loop": "2200ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.25, 0.8, 0.25, 1)"
    }
  },
  "z": {
    "dropdown": "1000",
    "sticky": "1100",
    "overlay": "1200",
    "modal": "1300",
    "tooltip": "1400"
  },
  "safe-area": {
    "inset": {
      "top": "env(safe-area-inset-top, 0px)",
      "right": "env(safe-area-inset-right, 0px)",
      "bottom": "env(safe-area-inset-bottom, 0px)",
      "left": "env(safe-area-inset-left, 0px)"
    }
  },
  "$coarse": {
    "target": {
      "min": "2.75rem"
    }
  }
}
