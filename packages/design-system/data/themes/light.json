{
  "$schema": "../../schema/theme.schema.json",
  "name": "light",
  "colorScheme": "light",
  "default": true,
  "seeds": {
    "neutral": "#737a99",
    "brand": "#4f46e5",
    "warning": "#f5a20a",
    "tertiary": "#8a7b6a",
    "danger": "#c4364f"
  },
  "tokens": {
    "surface": {
      "base": "#ffffff",
      "subtle": "{color.neutral.100}",
      "muted": "{color.neutral.200}",
      "inverse": "{color.neutral.900}",
      "overlay": "rgba(23, 25, 60, 0.48)"
    },
    "text": {
      "primary": "{color.neutral.900}",
      "secondary": "{color.neutral.700}",
      "hint": "{color.neutral.600}",
      "disabled": "{color.neutral.500}",
      "inverse": "#ffffff",
      "link": "{role.brand.fg}"
    },
    "border": {
      "subtle": "{color.neutral.300}",
      "base": "{color.neutral.500}",
      "strong": "{color.neutral.600}",
      "disabled": "{color.neutral.300}"
    },
    "focus": { "ring": "{role.brand.border}" },
    "role": {
      "accent": "{role.brand.solid}",
      "accent-fg": "{role.brand.fg}",
      "accent-subtle": "{role.brand.subtle}",
      "accent-border": "{role.brand.border}"
    },
    "on": { "accent": "{role.brand.on-solid}" }
  }
}
