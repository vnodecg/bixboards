{
  "name": "@bixant/data-list",
  "version": "0.0.0",
  "description": "Bixant virtualized list/grid and tree: bx-data-list and bx-virtual-tree, built on core VirtualizerController.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/data-list/index.js",
    "./dist/virtual-tree/index.js"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./data-list": {
      "types": "./dist/data-list/index.d.ts",
      "default": "./dist/data-list/index.js"
    },
    "./data-list/define": {
      "types": "./dist/data-list/define.d.ts",
      "default": "./dist/data-list/define.js"
    },
    "./virtual-tree": {
      "types": "./dist/virtual-tree/index.d.ts",
      "default": "./dist/virtual-tree/index.js"
    },
    "./virtual-tree/define": {
      "types": "./dist/virtual-tree/define.d.ts",
      "default": "./dist/virtual-tree/define.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@bixant/core": "workspace:*",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@bixant/design-system": "workspace:*",
    "@open-wc/testing": "^5.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.0",
    "@web/dev-server-esbuild": "^2.0.0",
    "@web/test-runner": "^1.0.0",
    "@web/test-runner-commands": "^1.0.1",
    "@web/test-runner-playwright": "^1.0.0",
    "playwright": "^1.63.0"
  }
}
