{
  "name": "angular",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/angular/src",
  "implicitDependencies": [
    "core",
    "data-list",
    "data-table"
  ],
  "targets": {
    "generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/wrappers/generate.mts angular",
        "cwd": "."
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^default"
      ],
      "dependsOn": [
        "^build"
      ],
      "options": {
        "command": "web-test-runner",
        "cwd": "packages/angular"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": [
        "^build"
      ],
      "options": {
        "command": "ngc -p tsconfig.lib.json",
        "cwd": "packages/angular"
      },
      "outputs": [
        "{projectRoot}/dist"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": [
        "^build"
      ],
      "options": {
        "command": "tsc -p tsconfig.spec.json --noEmit",
        "cwd": "packages/angular"
      }
    }
  }
}
