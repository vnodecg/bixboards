{
  "name": "@bixboards/angular",
  "version": "0.0.0",
  "description": "Angular standalone components for every Bixboards element (with ControlValueAccessor for form controls), generated from the Custom Elements Manifests.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/generated/*.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/generated/*.d.ts",
      "default": "./dist/generated/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "node ../../tools/wrappers/generate.mts angular"
  },
  "peerDependencies": {
    "@angular/core": ">=19",
    "@angular/forms": ">=19"
  },
  "dependencies": {
    "@bixboards/core": "workspace:*",
    "@bixboards/data-list": "workspace:*",
    "@bixboards/data-table": "workspace:*"
  },
  "devDependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "rxjs": "^7.8.0"
  }
}
