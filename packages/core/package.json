{
  "name": "@bixant/core",
  "version": "0.0.0",
  "description": "Bixant general component catalog: base classes, VirtualizerController and general-purpose custom elements. Consumes @bixant/design-system tokens.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/*/index.js"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./animated-image": {
      "types": "./dist/animated-image/index.d.ts",
      "default": "./dist/animated-image/index.js"
    },
    "./animated-image/define": {
      "types": "./dist/animated-image/define.d.ts",
      "default": "./dist/animated-image/define.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@bixant/design-system": "workspace:*",
    "@open-wc/testing": "^5.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.0",
    "@web/dev-server-esbuild": "^2.0.0",
    "@web/test-runner": "^1.0.0",
    "@web/test-runner-commands": "^1.0.1",
    "@web/test-runner-playwright": "^1.0.0",
    "playwright": "^1.63.0"
  }
}
